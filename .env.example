# Copy to .env.local and fill in. Never commit a filled-in copy.
# Only variables prefixed NEXT_PUBLIC_ reach the browser.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project region must be ap-south-1 (Mumbai) — ARCHITECTURE.md §1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server and edge functions ONLY. This key bypasses every RLS policy in the
# database. If it is ever prefixed NEXT_PUBLIC_ it ships in the client bundle
# and every student can read every other student's data. §7 checks this.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
# Law 1: every call is attached to one countable event and logged to ai_usage.
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_REASONING=
# Hard per-cohort ceiling. Past this, submissions queue for manual review
# rather than spending. Set from measured cost, not from an estimate.
AI_COHORT_CEILING_PAISE=15000

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (via BSP) ───────────────────────────────────────────────────────
WA_PROVIDER=aisensy
WA_API_KEY=
WA_TEMPLATE_NUDGE=
WA_TEMPLATE_DEADLINE=

# ── YouTube ──────────────────────────────────────────────────────────────────
# Metadata only. Law 2: never transcripts, never captions, never summaries.
YOUTUBE_API_KEY=

# ── Everything else ──────────────────────────────────────────────────────────
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=https://jintu.in
