# Copy to .env.local and fill in. Never commit a filled-in copy.
# Only variables prefixed NEXT_PUBLIC_ reach the browser.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project region must be ap-south-1 (Mumbai) — ARCHITECTURE.md §1.
#
# NOTE: this file is the catalogue for the whole system. The Next app does NOT
# read it — Next loads env from the app directory, so the web app's values go
# in apps/web/.env.local. See apps/web/.env.example.
NEXT_PUBLIC_SUPABASE_URL=

# Client-side key. Supabase is replacing the JWT `anon` key with
# `sb_publishable_…`; set whichever your project issues.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server and edge functions ONLY. `sb_secret_…` (formerly service_role)
# bypasses every RLS policy in the database. If it is ever prefixed
# NEXT_PUBLIC_ it ships in the client bundle and every student can read every
# other student's data. §7 checks this, and so does the app at startup.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to verify JWTs server-side when validating a session.
SUPABASE_JWKS_URL=

# ── AI ───────────────────────────────────────────────────────────────────────
# Law 1: every call is attached to one countable event and logged to ai_usage.
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_REASONING=
# Hard per-cohort ceiling. Past this, submissions queue for manual review
# rather than spending. Set from measured cost, not from an estimate.
AI_COHORT_CEILING_PAISE=15000

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Sign-in SMS (Supabase Auth phone OTP) ────────────────────────────────────
# Read by `supabase config push`, not by the app. Supabase Auth owns the OTP —
# generating, expiring and verifying it — and hands the message to Twilio.
# With none of this set, the Phone provider stays off and signInWithOtp
# returns "provider disabled".
#
# Twilio console > Account Info for the SID and token; Messaging > Services
# for the messaging service SID.
#
# None of these send a single message to an Indian number until TRAI DLT
# registration is done: entity, header (sender ID), and the OTP template in
# supabase/config.toml, each approved on the operator portals.
#
# To test before any of that exists, add a test number under
# Authentication > Phone in the dashboard — a fixed code, no SMS, no cost.
# Remove it before real signups: it is a permanent backdoor into that account.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Meta Cloud API. Read by the send-sms edge function, which delivers sign-in
# codes, and from Phase 2 by the nudge cron. Set them on the project with
# `supabase secrets set --env-file .env`, not in the app's environment.
#
# WA_PHONE_NUMBER_ID is from Meta > WhatsApp > API Setup and is not the phone
# number. The number itself must be dedicated to the API — one already
# registered on the consumer WhatsApp app cannot be used.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# An approved AUTHENTICATION-category template. A code sent through a
# marketing or utility template is rejected.
WA_TEMPLATE_OTP=
# Must match the language the template was approved in. "en" and "en_US" are
# different templates to Meta.
WA_TEMPLATE_LANG=en

# Shared with Supabase Auth so it can sign hook deliveries, and with the
# function so it can check them. Generated when the hook is created in the
# dashboard; looks like `v1,whsec_…`. Without it the endpoint is public and
# anyone who finds the URL can send WhatsApp messages on our account.
SEND_SMS_HOOK_SECRET=

# Phase 2 nudge templates.
WA_PROVIDER=aisensy
WA_TEMPLATE_NUDGE=
WA_TEMPLATE_DEADLINE=

# ── YouTube ──────────────────────────────────────────────────────────────────
# Metadata only. Law 2: never transcripts, never captions, never summaries.
YOUTUBE_API_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# Both are optional and absence is a supported state: leave them blank and
# Sentry never initialises, PostHog never loads, and nothing is sent anywhere.
#
# A Sentry DSN is public by design (it ships in the browser bundle), which is
# why this one is NEXT_PUBLIC_. It is not a secret; the auth token used for
# source-map upload at build time is, and does not belong in this file.
NEXT_PUBLIC_SENTRY_DSN=

# PostHog only initialises once a signed-in user has granted the `analytics`
# consent purpose. Use an EU or India region host — see docs/LEGAL.md §2.4.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Everything else ──────────────────────────────────────────────────────────
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=https://jintu.in
