node_modules/
.pnpm-store/

# build output
.next/
out/
dist/
build/
*.tsbuildinfo

# regenerated by `next dev`/`next build`; references .next/types, which is ignored
next-env.d.ts

# turbo
.turbo/

# env — only .env.example is committed
.env
.env.*
!.env.example

# supabase local stack
supabase/.branches/
supabase/.temp/

# test + coverage
coverage/
playwright-report/
test-results/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# generated service worker (built by serwist)
# Leading **/ matters: a pattern containing a slash is anchored to the repo
# root, so bare `public/sw.js` never matched apps/web/public/sw.js and the
# built service worker showed up as an untracked file.
**/public/sw.js
**/public/sw.js.map
**/public/swe-worker-*.js
supabase/.bundle/

# PDFs dropped into docs/ are working files, not repo content. The repo holds
# markdown; a stray PDF here once went into a commit by accident.
docs/*.pdf
docs/*.zip
supabase/migrations.old/
docs/tracks/
