# Copy this file to `apps/web/.env.local` and fill it in.
#
# It must live HERE, next to next.config.ts — Next loads .env files from the
# app directory, not the monorepo root. A .env.local at the repo root is read
# by nothing.
#
# The root .env.example is the full catalogue of every variable the system
# will eventually need, including ones only edge functions use. This file is
# the subset the web app reads today.

# ── Required for /learn and the waitlist form ────────────────────────────────
# Supabase dashboard > your project > Settings > API.
# Project region must be ap-south-1 (Mumbai) — ARCHITECTURE.md §1.
# For a local stack (`pnpm db:start`) the URL is http://127.0.0.1:54321 and
# the CLI prints the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: leave blank and both stay off ──────────────────────────────────
# Sentry never initialises; PostHog never loads. Nothing is sent anywhere.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
