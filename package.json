    "bundle:budget": "node scripts/assert-bundle-budget.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "sharp": "^0.35.3",
    "supabase": "^2.113.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
}
