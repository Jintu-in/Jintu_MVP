{
  "name": "jintu",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "icons": "node assets/brand/generate-icons.mjs",
    "db:new": "supabase migration new",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --linked > packages/db/src/types.ts",
    "db:verify": "supabase db query --local --file supabase/tests/schema_guarantees.sql",
    "schema:rules": "node scripts/assert-schema-rules.mjs",
    "claims": "node scripts/assert-claims.mjs",
    "fn:deploy": "supabase functions deploy",
    "embeds": "node scripts/assert-embeds.mjs",
    "env:templates": "node scripts/assert-env-examples.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "supabase": "^2.113.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
}
