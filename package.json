    "baseline:verify": "node scripts/assert-baseline.mjs",
    "roadmap:import": "node scripts/import-roadmap.mjs",
    "import:verify": "node scripts/assert-import.mjs",
    "retention:verify": "node scripts/assert-retention.mjs",
    "progress:demo": "node scripts/demo-progress.mjs",
    "links:check": "node scripts/check-links.mjs",
    "metrics:demo": "node scripts/demo-metrics.mjs",
    "typography": "node scripts/assert-typography.mjs",
